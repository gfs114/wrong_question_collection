SERVER_IP=114.132.197.160
NODE_ENV=production
PORT=3000

DB_HOST=mysql
DB_PORT=3306
DB_NAME=wrong_question
DB_MIGRATION_USER=wqc_migration
DB_MIGRATION_PASSWORD=replace-with-random-alphanumeric-migration-password-at-least-32-characters
DB_RUNTIME_USER=wqc_runtime
DB_RUNTIME_PASSWORD=replace-with-random-alphanumeric-runtime-password-at-least-32-characters
DB_BACKUP_USER=wqc_backup
DB_BACKUP_PASSWORD=replace-with-random-alphanumeric-backup-password-at-least-32-characters
MYSQL_ROOT_PASSWORD=replace-with-a-different-random-root-password-at-least-32-characters

JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
DATA_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters

HUAWEI_CLIENT_ID=replace-after-appgallery-connect-setup
HUAWEI_CLIENT_SECRET=replace-after-appgallery-connect-setup
HUAWEI_TOKEN_URL=https://oauth-login.cloud.huawei.com/oauth2/v3/token
HUAWEI_PROFILE_URL=https://oauth-api.cloud.huawei.com/rest.php?nsp_fmt=JSON&nsp_svc=huawei.oauth2.user.getTokenInfo

# OCR worker: no extra secrets. The worker only receives DB runtime credentials
# and the shared import volume via compose; it never sees JWT, Huawei or backup
# secrets. Import storage tuning for the API lives inline in compose.yaml
# (IMPORT_STORAGE_ROOT=/work/imports, IMPORT_CONFIRM_MAX_BYTES=2097152, ...).
