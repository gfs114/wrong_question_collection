  name: 'AssertionError'
  expected:
  actual: |-
    import {
      BODY_FONT_SIZE,
      themePalette
    } from '../constants/AppTheme'
    import {
      BADGE_RADIUS,
      BADGE_SIZE,
      HAIRLINE,
      SECTION_TITLE_SIZE,
      SHEET_RADIUS
    } from '../constants/EditorialStyle'
    import { AppColors } from '../theme/AppColors'
    
    @Component
    export struct HomeRecentSection {
      @Prop title: string = ''
      @Prop emptyText: string = ''
      @Prop items: Array<string> = new Array<string>()
      @StorageProp('darkMode') darkMode: boolean = false
      onOpen: (index: number) => void = () => {
      }
    
      private colors(): AppColors {
        return themePalette(this.darkMode)
      }
    
      // 章节标题：小号间距字 + 右侧「查看全部」+ 一条细线（练习册章节感，不依赖共享 SectionTitle）。
      @Builder
      private SectionHead() {
        Column({ space: 10 }) {
          Row() {
            Text(this.title)
              .fontSize(13)
              .fontWeight(FontWeight.Bold)
              .letterSpacing(1)
              .fontColor(this.colors().textPrimary)
    
            Blank()
    
            if (this.items.length > 0) {
              Text('查看全部')
                .fontSize(12)
                .fontColor(this.colors().brand)
            }
          }
          .width('100%')
    
          Divider()
            .strokeWidth(HAIRLINE)
            .color(this.colors().divider)
        }
        .width('100%')
      }
    
      build() {
        Column({ space: 10 }) {
          this.SectionHead()
    
          if (this.items.length === 0) {
            Row({ space: 10 }) {
              Text('·')
                .width(28)
                .height(28)
                .fontSize(20)
                .fontWeight(FontWeight.Bold)
                .fontColor(this.colors().brand)
                .textAlign(TextAlign.Center)
                .backgroundColor(this.colors().brandSoft)
                .borderRadius(BADGE_RADIUS)
    
              Text(this.emptyText)
                .fontSize(BODY_FONT_SIZE)
                .fontColor(this.colors().textCaption)
            }
            .width('100%')
            .height(60)
            .padding({ left: 16, right: 16 })
            .backgroundColor(this.colors().cardBackground)
            .borderRadius(SHEET_RADIUS)
            .border({ width: HAIRLINE, color: this.colors().divider })
          } else {
            Column() {
              ForEach(this.items, (item: string, index: number) => {
                Row({ space: 12 }) {
                  // 序号做成方形书签，而不是圆点，贴近练习册的编号观感。
                  Text((index + 1).toString())
                    .width(28)
                    .height(28)
                    .fontSize(13)
                    .fontWeight(FontWeight.Bold)
                    .fontColor(this.colors().brand)
                    .textAlign(TextAlign.Center)
                    .backgroundColor(this.colors().brandSoft)
                    .borderRadius(BADGE_RADIUS)
    
                  Text(item)
                    .layoutWeight(1)
                    .fontSize(BODY_FONT_SIZE)
                    .fontColor(this.colors().textPrimary)
                    .maxLines(2)
                    .textOverflow({ overflow: TextOverflow.Ellipsis })
    
                  Text('›')
                    .fontSize(22)
                    .fontColor(this.colors().textCaption)
                }
                .width('100%')
                .padding({ left: 16, right: 14, top: 12, bottom: 12 })
                .onClick(() => {
                  this.onOpen(index)
                })
                .accessibilityText(item)
    
                if (index < this.items.length - 1) {
                  Divider()
                    .strokeWidth(HAIRLINE)
                    .margin({ left: 56 })
                    .color(this.colors().divider)
                }
              }, (item: string, index: number): string => index.toString() + item)
            }
            .width('100%')
            .backgroundColor(this.colors().cardBackground)
            .borderRadius(SHEET_RADIUS)
            .border({ width: HAIRLINE, color: this.colors().divider })
            .clip(true)
          }
        }
        .width('100%')
        .alignItems(HorizontalAlign.Start)
      }
    }
    
  operator: 'match'
  stack: |-
    TestContext.<anonymous> (G:\code\openHarmony\wrong_question_collection\entry\src\test\HomeUiFollowupContracts.test.cjs:38:10)
