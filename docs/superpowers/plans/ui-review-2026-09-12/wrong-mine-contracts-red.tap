      '\n' +
      '  aboutToAppear(): void {\n' +
      '    this.sizeObserver = new WindowSizeObserver((windowWidthVp: number): void => {\n' +
      '      this.applyWindowSizeClass(windowWidthVp)\n' +
      '    })\n' +
      '    this.sizeObserver.start(getContext(this))\n' +
      '    this.refreshWhenActive()\n' +
      '  }\n' +
      '\n' +
      '  aboutToDisappear(): void {\n' +
      '    if (this.sizeObserver !== undefined) {\n' +
      '      this.sizeObserver.stop()\n' +
      '      this.sizeObserver = undefined\n' +
      '    }\n' +
      '  }\n' +
      '\n' +
      '  private applyWindowSizeClass(windowWidthVp: number): void {\n' +
      '    const sizeClass: WindowSizeClass = ResponsiveLayout.classify(windowWidthVp)\n' +
      '    if (sizeClass !== this.windowSizeClass) {\n' +
      '      this.windowSizeClass = sizeClass\n' +
      '    }\n' +
      '  }\n' +
      '\n' +
      '  private contentMaxWidth(): number {\n' +
      '    if (this.windowSizeClass === WindowSizeClass.COMPACT) {\n' +
