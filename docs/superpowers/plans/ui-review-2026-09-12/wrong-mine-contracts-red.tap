      '    }\n' +
      '    subjects.sort()\n' +
      '    return subjects\n' +
      '  }\n' +
      '\n' +
      '  private filterBySubject(items: Array<WrongQuestionSummary>): Array<WrongQuestionSummary> {\n' +
      '    if (this.selectedSubject.length === 0) {\n' +
