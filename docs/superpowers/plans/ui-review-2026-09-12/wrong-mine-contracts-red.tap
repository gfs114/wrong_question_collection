      '  }\n' +
      '\n' +
      '  private async loadContent(token: number): Promise<void> {\n' +
      '    const session: AccountSessionState = await AccountSessionService.state(getContext(this))\n' +
      '    if (token !== this.requestToken) {\n' +
      '      return\n' +
      '    }\n' +
      '    this.signedIn = session.signedIn\n' +
      '    this.accountId = session.userId\n' +
      '    if (!this.signedIn) {\n' +
      '      this.statistics = new Statistics(0, 0, 0, 0)\n' +
      '      this.subjects = new Array<string>()\n' +
      '      this.items = new Array<WrongQuestionSummary>()\n' +
      '      this.loading = false\n' +
      '      return\n' +
      '    }\n' +
      '    try {\n' +
      '      await CloudQuestionRepository.refresh(this.accountId, getContext(this))\n' +
      '      if (token !== this.requestToken) {\n' +
      '        return\n' +
      '      }\n' +
      '      this.offline = false\n' +
      '      this.syncFailed = false\n' +
      '    } catch (err) {\n' +
      '      if (token !== this.requestToken) {\n' +
      '        return\n' +
      '      }\n' +
      '      if (err instanceof Error && ConnectivityPolicy.isOfflineError(err)) {\n' +
      '        this.offline = true\n' +
      '        this.syncFailed = false\n' +
      '      } else {\n' +
      '        this.offline = false\n' +
      '        this.syncFailed = true\n' +
      '      }\n' +
      '    }\n' +
      '    try {\n' +
      '      const statistics: Statistics = await CloudQuestionRepository.statistics(this.accountId)\n' +
      '      const items: Array<WrongQuestionSummary> =\n' +
      '        await CloudQuestionRepository.listCachedWrongQuestions(this.accountId)\n' +
      '      const subjects: Array<string> = this.deriveSubjects(items)\n' +
      '      if (token !== this.requestToken) {\n' +
      '        return\n' +
      '      }\n' +
      '      if (this.selectedSubject.length > 0 && !this.containsSubject(subjects, this.selectedSubject)) {\n' +
      "        this.selectedSubject = ''\n" +
      '      }\n' +
      '      this.statistics = statistics\n' +
      '      this.subjects = subjects\n' +
      '      this.items = this.filterBySubject(items)\n' +
      '      this.loading = false\n' +
      '    } catch (err) {\n' +
      '      if (token !== this.requestToken) {\n' +
      '        return\n' +
      '      }\n' +
      "      this.errorMessage = '错题数据加载失败，请稍后重试'\n" +
      '      this.loading = false\n' +
